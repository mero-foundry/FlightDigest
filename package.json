{
  "name": "flightdigest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc -b && vite build",
    "preview": "npm run build && npm start",
    "start": "NODE_ENV=production node server/index.js",
    "lint": "oxlint",
    "test:unit": "node --test server/*.test.js",
    "test:e2e": "playwright test",
    "ci": "npm run lint && npm run test:unit && npm run build && npm run test:e2e && npm audit --audit-level=moderate"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "vite": "^7.2.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^10.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2"
  }
}
